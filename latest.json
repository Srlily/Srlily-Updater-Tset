{
  "schemaVersion": 1,
  "appId": "srlily-updater-tset",
  "name": "Srlily Updater Test",
  "description": "用于测试 Srlily-Updater 更新流程的示例桌面应用",
  "channel": "stable",
  "version": "1.0.13",
  "minOs": "windows-10",
  "runtime": "net10.0-windows",
  "homepage": "https://github.com/Srlily/Srlily-Updater-Tset",
  "releases": {
    "api": "https://api.github.com/repos/Srlily/Srlily-Updater-Tset/releases/latest",
    "downloadPattern": "Srlily.UpdaterTset-v{version}-{rid}-portable.zip",
    "assetName": "Srlily.UpdaterTset-v{version}-{rid}-portable.zip",
    "defaultRid": "win-x64",
    "architectures": {
      "x64": {
        "rid": "win-x64",
        "portable": "Srlily.UpdaterTset-v{version}-win-x64-portable.zip",
        "setup": "Srlily.UpdaterTset-v{version}-win-x64-setup.exe",
        "msi": "Srlily.UpdaterTset-v{version}-win-x64.msi"
      },
      "arm64": {
        "rid": "win-arm64",
        "portable": "Srlily.UpdaterTset-v{version}-win-arm64-portable.zip",
        "setup": "Srlily.UpdaterTset-v{version}-win-arm64-setup.exe",
        "msi": "Srlily.UpdaterTset-v{version}-win-arm64.msi"
      },
      "x86": {
        "rid": "win-x86",
        "portable": "Srlily.UpdaterTset-v{version}-win-x86-portable.zip",
        "setup": "Srlily.UpdaterTset-v{version}-win-x86-setup.exe",
        "msi": "Srlily.UpdaterTset-v{version}-win-x86.msi"
      }
    }
  },
  "entry": {
    "executable": "Srlily.UpdaterTset.exe",
    "cliArgs": [
      "--version"
    ]
  },
  "checksum": {
    "algorithm": "SHA256",
    "file": "SHA256SUMS.txt"
  },
  "paths": {
    "installRoot": ".",
    "config": "Config",
    "locales": "Locales",
    "data": "Data",
    "plugins": "Plugins",
    "backup": ".srlily-updater/backup",
    "staging": ".srlily-updater/staging"
  },
  "updatePolicy": {
    "checkOnStartup": true,
    "promptBeforeInstall": true,
    "atomicReplace": true,
    "verifyChecksum": true,
    "restartAfterUpdate": true,
    "preferInstallerForFirstInstall": true,
    "preferPortableForInPlaceUpdate": true
  }
}
