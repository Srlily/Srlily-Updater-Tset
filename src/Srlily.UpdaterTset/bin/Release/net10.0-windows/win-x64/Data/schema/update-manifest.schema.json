{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Srlily/Srlily-Updater-Tset/schemas/update-manifest.schema.json",
  "title": "Srlily Update Manifest",
  "type": "object",
  "required": ["schemaVersion", "appId", "name", "version", "channel", "releases", "entry"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "appId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "channel": { "type": "string", "enum": ["stable", "beta", "nightly"] },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
    },
    "runtime": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "releases": {
      "type": "object",
      "required": ["api"],
      "properties": {
        "api": { "type": "string", "format": "uri" },
        "downloadPattern": { "type": "string" },
        "assetName": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "required": ["executable"],
      "properties": {
        "executable": { "type": "string" },
        "cliArgs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checksum": {
      "type": "object",
      "properties": {
        "algorithm": { "type": "string", "enum": ["SHA256", "SHA512"] },
        "file": { "type": "string" }
      }
    },
    "paths": {
      "type": "object",
      "properties": {
        "installRoot": { "type": "string" },
        "config": { "type": "string" },
        "locales": { "type": "string" },
        "data": { "type": "string" },
        "plugins": { "type": "string" },
        "backup": { "type": "string" },
        "staging": { "type": "string" }
      }
    },
    "updatePolicy": {
      "type": "object",
      "properties": {
        "checkOnStartup": { "type": "boolean" },
        "promptBeforeInstall": { "type": "boolean" },
        "atomicReplace": { "type": "boolean" },
        "verifyChecksum": { "type": "boolean" },
        "restartAfterUpdate": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": false
}
